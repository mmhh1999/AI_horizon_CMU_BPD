# Copy to .env (git-ignored) and fill in. Never commit real keys.

# Which runtime LLM provider src/server/app.py uses: "claude" or "groq".
# See src/server/providers.py to add another.
LLM_PROVIDER=groq

# --- claude ---
# Anthropic API key. Picked up by the `anthropic` SDK when set.
ANTHROPIC_API_KEY=

# --- groq ---
# Groq API key (console.groq.com -> API Keys). Picked up by the `groq` SDK when set.
GROQ_API_KEY=

# Model id passed to whichever provider is active. Leave unset to use each
# provider's default (claude-opus-5, or openai/gpt-oss-120b for Groq — Groq's
# free-tier lineup changes often; check console.groq.com or GET /openai/v1/models
# with your key for what's actually available if the default 404s).
LLM_MODEL=

# Port the local explain-proxy listens on.
LLM_PROXY_PORT=8799
